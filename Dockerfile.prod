# Imagen de producción: compila el juego y lo sirve como web estática con nginx.
#   docker build -f Dockerfile.prod -t poketower .
#   docker run -p 8080:80 poketower      -> http://localhost:8080
# (o: docker compose -f docker-compose.prod.yml up --build)

# 1) Compilación: comprueba tipos, pasa los tests y genera dist/
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm test && npm run build

# 2) Servidor: solo los ficheros compilados, sin Node ni código fuente
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
